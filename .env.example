# Sao chép sang .env.local; cấu hình ứng dụng Web, không phải khóa quản trị.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_ADMIN_UID=
VITE_FIREBASE_ADMIN_EMAIL=
VITE_FIREBASE_CLOUD_ENABLED=false
VITE_FIREBASE_ALLOW_CLOUD_WRITES=false
# Chỉ dùng khi chạy bộ giả lập cục bộ, không bật khi triển khai.
VITE_FIREBASE_USE_EMULATORS=false
# Để trống để dùng /api ngay trên cùng website Vercel.
# KHÔNG đặt private key/service account vào biến VITE_*.
VITE_ADMIN_API_URL=
