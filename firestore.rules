rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null && request.auth.uid == 'FBeRHAsHrNPeuhmfUF6yeF8QmMs2';
    }
    function hasRole(roles) {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role in roles
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.email == request.auth.token.email;
    }
    function isAdmin() { return isSuperAdmin() || hasRole(['admin']); }
    function canReadSubmissions() { return isSuperAdmin() || hasRole(['admin', 'reviewer']); }
    match /admin_users/{uid} {
      allow get: if isSuperAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, create, update, delete: if false;
    }
    function validStore(store) {
      return store in ['program_info', 'challenges', 'page_documents', 'faqs', 'awards', 'featured_individuals', 'featured_contents', 'leaderboards'];
    }
    function isActive(generation) {
      return exists(/databases/$(database)/documents/site/state)
        && get(/databases/$(database)/documents/site/state).data.activeGeneration == generation;
    }
    match /site/state {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['activeGeneration', 'changeId', 'updatedAt'])
        && request.resource.data.activeGeneration is string
        && request.resource.data.changeId is string
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
    match /datasets/{generation}/privateStores/{store} {
      allow read, write: if isAdmin() && validStore(store);
      match /records/{id} {
        allow read, write: if isAdmin() && validStore(store);
        match /parts/{part} { allow read, write: if isAdmin() && validStore(store); }
      }
    }
    match /datasets/{generation}/publicStores/{store}/records/{id} {
      // Only active, explicitly published projections belong here. Drafts stay in privateStores.
      allow read: if validStore(store) && (isAdmin() || isActive(generation));
      allow write: if isAdmin() && validStore(store);
      match /parts/{part} {
        allow get: if validStore(store) && (isAdmin() || (
          isActive(generation)
          && exists(/databases/$(database)/documents/datasets/$(generation)/publicStores/$(store)/records/$(id))
          && get(/databases/$(database)/documents/datasets/$(generation)/publicStores/$(store)/records/$(id)).data.revision == resource.data.revision
        ));
        allow list: if isAdmin() && validStore(store);
        allow write: if isAdmin() && validStore(store);
      }
    }
    match /submission_settings/public {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['enabled'])
        && request.resource.data.keys().hasOnly(['enabled'])
        && request.resource.data.enabled is bool;
      allow delete: if false;
    }
    match /submissions/{id} {
      allow read: if canReadSubmissions();
      // Create only: participants cannot read, replace, delete or backdate entries.
      allow create: if exists(/databases/$(database)/documents/submission_settings/public)
        && get(/databases/$(database)/documents/submission_settings/public).data.enabled == true
        && id.matches('[a-f0-9-]{36}')
        && request.resource.data.keys().hasAll(['fullName', 'phone', 'branch', 'originalUrl', 'submittedAt'])
        && request.resource.data.keys().hasOnly(['fullName', 'phone', 'branch', 'originalUrl', 'submittedAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('[+]?[0-9]{9,15}')
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 120
        && request.resource.data.branch is string
        && request.resource.data.branch.size() >= 2 && request.resource.data.branch.size() <= 160
        && request.resource.data.originalUrl is string
        && request.resource.data.originalUrl.size() <= 2000
        && request.resource.data.originalUrl.matches('https?://[^\\s]+')
        && request.resource.data.submittedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasAll(['fullName', 'phone', 'branch', 'originalUrl', 'submittedAt', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['fullName', 'phone', 'branch', 'originalUrl', 'submittedAt', 'updatedAt', 'updatedBy'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.matches('[+]?[0-9]{9,15}')
        && request.resource.data.branch is string
        && request.resource.data.branch.size() >= 2 && request.resource.data.branch.size() <= 160
        && request.resource.data.originalUrl is string
        && request.resource.data.originalUrl.size() <= 2000
        && request.resource.data.originalUrl.matches('https?://[^\\s]+')
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
