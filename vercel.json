{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/generated/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/homepage"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
