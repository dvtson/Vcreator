{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/generated/**"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/api/homepage"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!api(?:/|$)).*",
      "dest": "/index.html"
    }
  ]
}
